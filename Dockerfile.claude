FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

RUN install -d -m 0755 /usr/local/bin
COPY scripts/apt-install /usr/local/bin/apt-install
COPY scripts/apt-packages-common /usr/local/share/apt-packages-common
RUN chmod +x /usr/local/bin/apt-install

# Install curl, compiler and supplementary tools
RUN apt-install $(cat /usr/local/share/apt-packages-common) \
    ca-certificates \
    gcc \
    libc-dev

# Compile getuid bypass library for root restriction bypass (process-specific)
RUN printf '#define _GNU_SOURCE\n#include <unistd.h>\n#include <sys/types.h>\n#include <string.h>\nextern char *program_invocation_short_name;\nuid_t getuid(void) {\n    if (program_invocation_short_name && (strcmp(program_invocation_short_name, "claude") == 0 || strcmp(program_invocation_short_name, "claude-real") == 0 || strcmp(program_invocation_short_name, "node") == 0)) return 1000;\n    return 0;\n}\nuid_t geteuid(void) {\n    if (program_invocation_short_name && (strcmp(program_invocation_short_name, "claude") == 0 || strcmp(program_invocation_short_name, "claude-real") == 0 || strcmp(program_invocation_short_name, "node") == 0)) return 1000;\n    return 0;\n}\n' > /tmp/mock_uid.c && \
    gcc -shared -fPIC -o /usr/local/lib/libmockuid.so /tmp/mock_uid.c && \
    rm /tmp/mock_uid.c

# Install lazygit
COPY scripts/lazygit-install /usr/local/bin/lazygit-install
RUN chmod +x /usr/local/bin/lazygit-install && lazygit-install

# Install Claude Code using the provided command
RUN curl -fsSL https://claude.ai/install.sh | bash

# Wrap the claude executable to load the getuid bypass only when using --dangerously-skip-permissions
RUN mv /root/.local/bin/claude /root/.local/bin/claude-real && \
    echo '#!/usr/bin/env bash' > /root/.local/bin/claude && \
    echo 'export CLAUDE_CODE_RETRY_WATCHDOG=1' >> /root/.local/bin/claude && \
    echo 'export CLAUDE_CODE_MAX_RETRIES=9999' >> /root/.local/bin/claude && \
    echo 'if [[ "$*" == *"--dangerously-skip-permissions"* ]]; then' >> /root/.local/bin/claude && \
    echo '  mkdir -p /tmp/claude-1000 && chown -R 1000:1000 /tmp/claude-1000' >> /root/.local/bin/claude && \
    echo '  LD_PRELOAD=/usr/local/lib/libmockuid.so exec /root/.local/bin/claude-real "$@"' >> /root/.local/bin/claude && \
    echo 'else' >> /root/.local/bin/claude && \
    echo '  exec /root/.local/bin/claude-real "$@"' >> /root/.local/bin/claude && \
    echo 'fi' >> /root/.local/bin/claude && \
    chmod +x /root/.local/bin/claude

# Add Claude to PATH (installed to ~/.local/bin by the script)
ENV PATH="/root/.local/bin:${PATH}"

# Set the default working directory
WORKDIR /workspace

# Ensure /usr/local/bin exists and add the tmux layout script
ADD scripts/start-tmux-layout /usr/local/bin/start-tmux-layout
RUN chmod +x /usr/local/bin/start-tmux-layout

# Start the tmux layout on login
CMD ["-lc", "start-tmux-layout"]
